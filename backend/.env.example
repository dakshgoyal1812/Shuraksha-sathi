# EvacuSafe Backend Environment Variables
HOST=127.0.0.1
PORT=8000
DATABASE_URL=sqlite:///./evacusafe.db

# Primary Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Failover Rotation OpenRouter API Key
OPENROUTER_API_KEY=your_openrouter_api_key_here

# OpenWeatherMap API Key (Weather, Flood & Drought Assessment)
OPENWEATHER_API_KEY=your_openweather_api_key_here

